# Enable only after an approved, tested server-side integration is deployed.
# Public URL only. Never put API keys or CRM credentials in VITE_ variables.
VITE_LEAD_ENDPOINT=

# Server-only values. Never prefix these with VITE_.
# Use the /exec URL returned by the Google Apps Script web-app deployment.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# Optional explicit HTTPS origin of a temporary review tunnel (server-only).
# Restart dev/preview after setting it. Vite allows only this added hostname.
SHARE_ORIGIN=
